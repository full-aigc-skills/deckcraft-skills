{
  "schema": "craft-scenario-playbooks/v1",
  "application": "deckcraft",
  "id": "weekly-report",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "建立本周结论页",
      "command": "slide.new",
      "params": {
        "layout": "titleAndContent",
        "title": "本周结论",
        "body": "完成项 / 风险 / 下周行动"
      }
    },
    {
      "purpose": "创建真实趋势数据图",
      "command": "insert.chart",
      "params": {
        "type": "line",
        "categories": [
          "上周",
          "本周"
        ],
        "series": [
          {
            "name": "完成量",
            "values": [
              21,
              42
            ]
          }
        ]
      }
    },
    {
      "purpose": "记录口径与责任人",
      "command": "slide.notes",
      "params": {
        "text": "说明统计周期、数据口径和行动责任人"
      }
    }
  ],
  "check": "图表与原表相符，区分已完成、进行中和阻塞。",
  "boundary": "例子数值不得带入真实周报；先确认周期与统计口径。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
