{
  "schema": "craft-scenario-playbooks/v1",
  "application": "deckcraft",
  "id": "data-story",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "先建立结论标题页",
      "command": "slide.new",
      "params": {
        "layout": "titleOnly",
        "title": "结论与数据依据"
      }
    },
    {
      "purpose": "用真实数据创建比较图",
      "command": "insert.chart",
      "params": {
        "type": "column",
        "categories": [
          "A",
          "B"
        ],
        "series": [
          {
            "name": "指标",
            "values": [
              21,
              42
            ]
          }
        ]
      }
    },
    {
      "purpose": "标注数据来源与限制",
      "command": "slide.notes",
      "params": {
        "text": "原表、单位、时间范围、异常项与比较限制"
      }
    }
  ],
  "check": "图表比例不误导，结论与证据一致，使用同口径比较。",
  "boundary": "不为视觉冲击截断轴或隐藏不利数据；图例单位必须可读。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
